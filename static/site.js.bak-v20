const menu=document.querySelector('.menu'),nav=document.querySelector('nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav.classList.toggle('open',open)});document.addEventListener('keydown',e=>{if(e.key==='Escape'){nav?.classList.remove('open');menu?.setAttribute('aria-expanded','false')}});const form=document.querySelector('#cerere');if(form){const part=new URLSearchParams(location.search).get('part');if(part)form.querySelector('[name=piesa]').value=part.slice(0,1500);form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const status=document.querySelector('#form-status');if(form.elements.website?.value)return;let previous=0;try{previous=Number(sessionStorage.getItem('fordcargo-last-quote')||0)}catch{}if(Date.now()-previous<30000){status.textContent='Așteaptă 30 de secunde înainte de a pregăti o altă cerere.';return}const data=new FormData(form);const clean=v=>String(v||'Nespecificat').normalize('NFKC').replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g,'').trim();const text=['Bună ziua! Vă contactez de pe fordcargo.ro. Doresc o ofertă pentru piese de camion Ford.',...['prenume','nume','telefon','email','vin','piesa'].map(key=>key+': '+clean(data.get(key)))].join('\n');try{sessionStorage.setItem('fordcargo-last-quote',String(Date.now()))}catch{}location.href='https://wa.me/40733357357?text='+encodeURIComponent(text);status.textContent='Cererea este pregătită în WhatsApp. Apasă Trimite acolo pentru a o expedia.'});form.querySelector('[type=submit]').disabled=false;}
document.querySelectorAll('.photo-motion-toggle').forEach(button=>button.addEventListener('click',()=>{const paused=button.closest('.animated-photo').classList.toggle('paused');button.setAttribute('aria-pressed',String(paused));button.setAttribute('aria-label',paused?'Pornește mișcarea fotografiei':'Oprește mișcarea fotografiei');button.firstElementChild.textContent=paused?'▷':'Ⅱ'}));

document.querySelectorAll('.icon-motion-toggle').forEach(button=>button.addEventListener('click',()=>{const paused=button.closest('.icon-carousel').classList.toggle('paused');button.setAttribute('aria-pressed',String(paused));button.setAttribute('aria-label',paused?'Reia derularea pieselor':'Oprește derularea pieselor');button.firstElementChild.textContent=paused?'▷':'Ⅱ'}));
